{
  "expo": {
    "name": "IGLOO",
    "slug": "igloo-pomodoro",
    "version": "1.0.0",
    "orientation": "portrait",
    "web": { "bundler": "metro" },
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": [["expo-audio", { "microphonePermission": false, "recordAudioAndroid": false }], "expo-notifications"],
    "ios": { "supportsTablet": false, "bundleIdentifier": "co.igloo.pomodoro", "infoPlist": { "UIBackgroundModes": ["audio"] } },
    "android": {
      "package": "co.igloo.pomodoro",
      "adaptiveIcon": { "backgroundColor": "#DBF0FA" },
      "blockedPermissions": ["android.permission.RECORD_AUDIO"]
    }
  }
}
