  "stateMachine": {
    "name": "PenguinHatchery",
    "inputs": [
      { "name": "tapOne", "type": "trigger" },
      { "name": "tapTwo", "type": "trigger" },
      { "name": "hatch", "type": "trigger" }
    ],
    "layers": [
      {
        "name": "Hatching",
        "states": [
          { "name": "waiting", "animation": "eggIdle" },
          { "name": "tapOne", "animation": "tapOne" },
          { "name": "cracked1", "animation": "eggCrack1" },
          { "name": "tapTwo", "animation": "tapTwo" },
          { "name": "cracked2", "animation": "eggCrack2" },
          { "name": "hatching", "animation": "eggHatch" },
          { "name": "empty", "animation": "eggEmpty" }
        ],
        "transitions": [
          { "from": "entry", "to": "waiting" },
          { "from": "waiting", "to": "tapOne", "condition": { "input": "tapOne" } },
          { "from": "tapOne", "to": "cracked1", "exitTimeMs": 700 },
          { "from": "cracked1", "to": "tapTwo", "condition": { "input": "tapTwo" } },
          { "from": "tapTwo", "to": "cracked2", "exitTimeMs": 900 },
          { "from": "cracked2", "to": "hatching", "condition": { "input": "hatch" } },
          { "from": "hatching", "to": "empty", "exitTimeMs": 3000 }
        ]
      }
    ]
  }
